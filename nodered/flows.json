        "func": "const message = {\n  role: \"user\",\n  content: `你是一个中文智能家庭音箱，请播报未来12小时的温度和天气情况，*回答必须在一句话以内，语气略微欢快但别轻佻*：\n        \"\"\"\n        ${JSON.stringify(msg.payload)}\n        \"\"\"\n        `\n}\n\nconst data = {\n  model: \"Qwen/Qwen3.5-4B\",\n  messages: [message]\n}\n\nmsg.payload = data\n\nreturn msg",
